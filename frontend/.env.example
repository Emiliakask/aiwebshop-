# Copy this file to .env.local and adjust.
# Everything prefixed with VITE_ ends up in the public bundle — never put secrets here.

# Base URL of the backend API.
VITE_API_URL=http://localhost:3000/api

# "true" = serve fake API responses from src/mocks (no backend needed).
VITE_ENABLE_MOCKS=true

# "true" (with mocks on) = products come from the real backend; cart and orders stay mocked.
VITE_REAL_PRODUCTS=false
