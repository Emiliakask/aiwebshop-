# Copy to backend/.env and fill in. backend/.env is git-ignored. Never commit real values.

# Database
DB_URL=jdbc:postgresql://localhost:5432/webshop
DB_USERNAME=postgres
DB_PASSWORD=change-me

# React app URL (CORS + where to go after admin login)
FRONTEND_URL=http://localhost:5173
# true in production (HTTPS only cookies)
COOKIE_SECURE=false

# Admin login: Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
# Authorized redirect URI: http://localhost:3000/login/oauth2/code/google
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
# Gmail addresses allowed into the admin module, comma-separated
ADMIN_EMAILS=you@gmail.com

# Customer login with Smart-ID, directly to SK (see ../docs/auth.md)
# demo = SK demo service + SK demo accounts (e.g. EE 40504040001); production = real customers.
SMARTID_ENV=demo
# Production only: relying party UUID and name from the SK contract. Leave empty in demo.
SMARTID_RP_UUID=
SMARTID_RP_NAME=
# Optional: override the SK API URL of the chosen environment.
SMARTID_HOST_URL=
# Demo only: "Log in as test user" button. Must be false (or absent) in production.
SMARTID_TEST_ACCOUNT=true

# EveryPay payments (see ../docs/payments.md). Merchant portal > General settings.
# Demo API: https://igw-demo.every-pay.com/api/v4   Production API: https://pay.every-pay.eu/api/v4
EVERYPAY_API_URL=https://igw-demo.every-pay.com/api/v4
EVERYPAY_API_USERNAME=change-me
EVERYPAY_API_SECRET=change-me
EVERYPAY_ACCOUNT_NAME=EUR3D1
# This backend's address as customers' browsers see it (EveryPay refuses localhost; localtest.me = 127.0.0.1).
# Production: https://your-shop-domain
PUBLIC_URL=http://localtest.me:3000

# Planned (see ../docs): email
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
# ADMIN_NOTIFY_EMAILS=
